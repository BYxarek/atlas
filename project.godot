config_version=5

[application]
boot_splash/bg_color=Color(0.035, 0.055, 0.075, 1)
boot_splash/image="res://assets/boot_splash.png"
boot_splash/stretch_mode=1
boot_splash/show_image=true
boot_splash/use_filter=true
config/version="0.2.0"
config/name="ATLAS — Мировое господство"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.8", "GL Compatibility")
config/icon="res://assets/icon.svg"
config/use_custom_user_dir=true
config/custom_user_dir_name="AtlasWorldGame"
config/quit_on_go_back=false
config/name_localized={"en": "ATLAS — World Domination", "ru": "ATLAS — Мировое господство"}

[audio]
buses/gui_theme_bus="Interface"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/size/min_width=1120
window/size/min_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.055, 0.075, 1)
textures/vram_compression/import_etc2_astc=true

[gui]
theme/default_font_multichannel_signed_distance_field=true

